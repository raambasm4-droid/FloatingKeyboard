{
  "schemaVersion": 1,
  "id": "floating_keyboard",
  "version": "${version}",
  "name": "Floating Keyboard",
  "description": "A floating, touch-friendly two-page QWERTY keyboard for Minecraft text fields and chat.",
  "authors": ["Abhikaran"],
  "license": "MIT",
  "icon": "assets/floating_keyboard/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.abhikaran.floatingkeyboard.client.FloatingKeyboardClient"],
    "modmenu": ["com.abhikaran.floatingkeyboard.client.ModMenuIntegration"]
  },
  "mixins": [
    "floating_keyboard.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": ">=17.0.0"
  }
}
